# SpeakWrite AI Environment Configuration

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Optional: If empty, embedded database will be used automatically)
MONGODB_URI=mongodb://localhost:27017/speakwrite_ai

# JWT Secret for User Authentication
JWT_SECRET=speakwrite_super_secret_jwt_key_987654321_production

# OpenAI API Key (Optional: If empty or invalid, built-in intelligent AI mock service will handle requests)
OPENAI_API_KEY=

# Optional: Voice model settings
OPENAI_TTS_MODEL=tts-1
OPENAI_WHISPER_MODEL=whisper-1
